use retrieval;
use std::cli;
fn check(ok: bool) { if !ok { stderr_line("retrieval check failed"); process_exit(1); } }
fn main() {
    let scores = retrieval_at_k([7, 7, 9, 12], [7, 9, 9], 3);
    check(at(scores, 0) == 2.0 / 3.0 && at(scores, 1) == 1.0 && at(scores, 2) == 1.0);
    check(at(scores, 3) == (1.0 + 2.0 / 3.0) / 2.0);
    let delayed = retrieval_at_k([99, 7], [7, 9], 4);
    check(at(delayed, 0) == 0.25 && at(delayed, 1) == 0.5 && at(delayed, 2) == 0.5 && at(delayed, 3) == 0.25);
    check(at(retrieval_at_k([], [3], 5), 3) == 0.0);
    check(at(retrieval_at_k([1, 2], [1, 2, 3], 1), 3) == 1.0);
    check(len(retrieval_at_k([3], [], 1)) == 0 && len(retrieval_at_k([1], [1], 0)) == 0);
    check(len(retrieval_at_k([-2], [1], 1)) == 0 && len(retrieval_at_k([1], [1.5], 2)) == 0);
    println!("retrieval checks passed");
}
